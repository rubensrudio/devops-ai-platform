# =============================================================================
# devops-ai-platform — Variáveis de ambiente
#
# INSTRUÇÃO: copie este arquivo para .env e ajuste os valores conforme
# necessário para o seu ambiente local.
#
#   cp .env.example .env
#
# O arquivo .env NUNCA deve ser commitado no repositório.
# =============================================================================

# Porta exposta pelo api-gateway.
# Se a porta estiver em uso, altere para qualquer porta disponível (ex: 3001).
API_PORT=3000

# Intervalo em segundos entre cada linha de heartbeat emitida pelo worker-service.
HEARTBEAT_INTERVAL=10

# Nível de log dos serviços. Valores aceitos: debug | info | warn | error
LOG_LEVEL=info
