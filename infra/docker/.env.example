# =============================================================================
# infra/docker/.env.example — Variaveis de ambiente para Docker Compose
#
# Este arquivo e uma copia de referencia do .env.example da raiz do repositorio.
# O docker-compose.yml carrega variaveis diretamente de ../../.env (raiz).
#
# OPCOES DE USO:
#
#   Opcao A (recomendada): use o .env da raiz do repositorio.
#     cd <raiz-do-repositorio>
#     cp .env.example .env
#     docker compose -f infra/docker/docker-compose.yml up --build
#
#   Opcao B: crie um .env local neste diretorio (infra/docker/.env).
#     cp infra/docker/.env.example infra/docker/.env
#     Edite infra/docker/.env conforme necessario.
#     Atualize env_file no docker-compose.yml para apontar para .env (local).
#
# O arquivo .env NUNCA deve ser commitado no repositorio (.gitignore ja cobre).
# =============================================================================

# Porta exposta pelo api-gateway.
# Se a porta 3000 ja estiver em uso, altere para qualquer porta disponivel.
# Exemplo: API_PORT=3001
API_PORT=3000

# Intervalo em segundos entre cada linha de heartbeat do worker-service.
HEARTBEAT_INTERVAL=10

# Nivel de log dos servicos. Valores aceitos: debug | info | warn | error
LOG_LEVEL=info
