# =============================================================================
# devops-ai-platform — .gitignore
# Cobre: secrets, Node.js, Python, Docker, SO (macOS/Windows/Linux), IDEs.
# Criado na TASK-001; complementado com entradas multi-OS na TASK-013.
# =============================================================================

# ---------------------------------------------------------------------------
# Environment / secrets — NUNCA commitar o .env real
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local

# ---------------------------------------------------------------------------
# Node.js
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
dist/
build/
*.log

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
ENV/
.Python
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
*.tar

# ---------------------------------------------------------------------------
# Sistema operacional
# ---------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# ---------------------------------------------------------------------------
# IDEs e editores
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# ---------------------------------------------------------------------------
# Artefatos de build genéricos
# ---------------------------------------------------------------------------
*.class
*.jar
*.war
*.ear
target/
out/

# ---------------------------------------------------------------------------
# Complementos TASK-013: edge cases multi-OS e ferramentas adicionais
# ---------------------------------------------------------------------------

# Node.js — artefatos adicionais
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.eslintcache
.parcel-cache
.next/
.nuxt/
.cache/
*.tsbuildinfo

# Python — tooling adicional
.pdm.toml
.pdm-python
__pypackages__/
.nox/
.tox/
*.pyd
*.pdb
Pipfile.lock
poetry.lock

# Docker — artefatos adicionais
.docker/
docker-compose.override.yml

# Terraform (preparação para Semana 3)
.terraform/
*.tfstate
*.tfstate.backup
*.tfstate.lock.info
.terraform.lock.hcl
crash.log

# Kubernetes / Helm (preparação para Semana 3)
kubeconfig
*.kubeconfig

# Logs genéricos
logs/
*.log.*
npm-debug.log
lerna-debug.log

# Temporários e editores de texto
*.tmp
*.temp
*.bak
*.orig
*.rej
.editorconfig.cache

# Relatórios de cobertura / testes
test-results/
coverage/
*.lcov
junit.xml
test-report.xml
.claude/settings.local.json
.specs/
